conda {

    enabled = true

}


process {

    withName: FASTQC {

        conda = 'bioconda::fastqc=0.12.1'

    }

    withName: TRIMMOMATIC {

        conda = 'bioconda::trimmomatic=0.33'

    }

    withName: SEQKIT_FQ2FA {

        conda = 'bioconda::seqkit=2.13.0'

    }

    withName: MULTIQC {

        conda = 'bioconda::multiqc'

    }

    withName: SALMON_INDEX {

        conda = 'bioconda::salmon'

    }

    withName: SALMON_QUANT {

        conda = 'bioconda::salmon'

    }

    withName: R_ANALYSIS {

        conda = "$projectDir/envs/r_analysis.yml"

    }

}