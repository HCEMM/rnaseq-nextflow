nextflow_process {

    name "Test LIMMA process"
    // Make sure this path correctly points to your process file from THIS test file
    script "../processes/r_analysis.nf"
    process "R_ANALYSIS"

    test("Run LIMMA on multiple quant directories") {

        when {
            // Mock parameters your process needs
            params {
                outdir = "tests/results"
            }
            process {
                """
				input[0] = [
                    file("${projectDir}/tests/data/quant/SRR1039508_quant"),
                    file("${projectDir}/tests/data/quant/SRR1039509_quant"),
                    file("${projectDir}/tests/data/quant/SRR1039512_quant"),
                    file("${projectDir}/tests/data/quant/SRR1039517_quant")
                ]
				input[1] = file("${projectDir}/tests/data/quant/tx2gene.csv")
				input[2] = file("${projectDir}/tests/data/quant/samples.csv")
                """
            }
        }

        then {
            assert process.success
            
			def pdfOut = process.out.get(0)[0]
            def csvOut = process.out.get(1)[0]

			assert file(pdfOut).exists()
            assert pdfOut.toString().endsWith("expression_summary.pdf")

			assert file(csvOut).exists()
            assert snapshot(csvOut).match("final_results_csv")
        }
    }
}