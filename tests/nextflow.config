// tests/nextflow.config
process {
    // Force processes to run locally inside the GitHub Actions container
    executor = 'local'


	withName: 'SALMON_QUANT' {
			cpus = 4
		}
}

// Ensure Apptainer (Singularity) is enabled to run your FastQC container
apptainer {
    enabled = true
    autoMounts = true
    runOptions = ''
}