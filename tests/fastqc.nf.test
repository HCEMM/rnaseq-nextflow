nextflow_process {

    name "Test FASTQC process"
    // Make sure this path correctly points to your process file from THIS test file
    script "../processes/fastqc.nf"
    process "FASTQC"

    test("Run FASTQC on paired FASTQ files") {

        when {
            // Mock parameters your process needs
            params {
                outdir = "tests/results"
            }
            process {
                """
                input[0] = tuple("sample", [
                    file("${projectDir}/tests/data/sample_1.fastq.gz"), 
                    file("${projectDir}/tests/data/sample_2.fastq.gz")
                ])
                """
            }
        }

        then {
            assert process.success
            
            def fastqcFiles = process.out.qc_results.flatten()
            // FastQC creates 1 zip and 1 html per input file (2 inputs = 4 outputs)
            assert fastqcFiles.size() == 4

            //def outputNames = process.out.qc_results.collect { file(it).name }
            assert fastqcFiles.any { it.toString().endsWith(".html") }
            assert fastqcFiles.any { it.toString().endsWith(".zip") }
        }
    }
}